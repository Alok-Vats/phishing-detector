{
  "manifest_version": 3,
  "name": "Phishing Detection Agent",
  "version": "1.0",
  "description": "Analyzes the current page using the Major Project Phishing Detection API.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ]
}
